# Supabase PostgreSQL Connection
POSTGRES_DBNAME=postgres
POSTGRES_HOST=your-project.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password

# Connection Pool Settings (Optimized for cross-region latency)
# Increase pool size to handle concurrent requests
POSTGRES_POOL_SIZE=10
# Allow overflow connections for burst traffic
POSTGRES_MAX_OVERFLOW=10
# Increase connect timeout for high latency (Philippines → Australia ~150-200ms)
POSTGRES_CONNECT_TIMEOUT=30
# Enable pre-ping to validate connections before use (prevents stale connections)
POSTGRES_PRE_PING=true
# Connection max age (1 hour)
POSTGRES_CONN_MAX_AGE=3600
# Max waiting for pool (0 = unlimited)
POSTGRES_MAX_WAITING=0
# Lock timeout (0 = no timeout, fail fast on lock contention)
POSTGRES_LOCK_TIMEOUT=5

# Enable PostgreSQL function for faster event inserts
# Avoids EXCLUSIVE table lock and reduces round-trips
POSTGRES_ENABLE_DB_FUNCTIONS=true

# Schema (default: public)
POSTGRES_SCHEMA=public

# Events table name
EVENTS_TABLE_NAME=stored_events

# Single row tracking (recommended for performance)
SINGLE_ROW_TRACKING=true

# Originator ID type (uuid or text)
ORIGINATOR_ID_TYPE=uuid

# Create tables on startup
CREATE_TABLE=true